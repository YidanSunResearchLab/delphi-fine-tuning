# ── Job output logs (not committed) ───────────────────────────────────────────
logs/*.out
logs/*.err

# ── Sensitive / PHI data (never commit) ───────────────────────────────────────
.env
investigator_nacc*.csv

# ── Large binary data files ────────────────────────────────────────────────────
Delphi-2M/data/nacc/train.bin
Delphi-2M/data/nacc/val.bin

